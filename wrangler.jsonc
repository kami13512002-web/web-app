{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "web-app-db",
      "database_id": "d169008c-2a7b-4a64-8848-e77373a76569"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "cfbe375e468d454b934cd1a265f7200c"
    }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
